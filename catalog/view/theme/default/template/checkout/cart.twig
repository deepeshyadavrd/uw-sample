}


/* =========================================
   RESTORE SAVED PINCODE ON CART PAGE
========================================= */

document.addEventListener('DOMContentLoaded', async function () {
    const input = document.getElementById('input-pincode');
    const button = document.querySelector('.search-pincode-btn-modal');
    const resultDiv = document.getElementById('cart-pincode-result');

    if (!input || !button || !resultDiv) return;

    button.dataset.mode = 'check';

    const savedPin = localStorage.getItem('selectedPincode');

    // No saved PIN: leave the field empty.
    // Do not fetch JSON.
    if (!savedPin || !/^\d{6}$/.test(savedPin)) {
        input.value = '';
        input.disabled = false;
        button.disabled = false;
        resultDiv.textContent = '';
        return;
    }

    // Use cached details first.
    const cached = getCachedPincode(savedPin);

    if (cached) {
        renderCartPincodeSuccess(
            savedPin, cached, input, button, resultDiv
        );
        return;
    }

    // Saved PIN has no valid cache: verify it against JSON.
    input.value = '';
    input.disabled = true;
    button.disabled = true;

    try {
        await loadPincodeData();

        const found = findPincode(savedPin);

        if (found) {
            localStorage.setItem(
                `pincode-${savedPin}`,
                JSON.stringify(found)
            );

            renderCartPincodeSuccess(
                savedPin, found, input, button, resultDiv
            );
        } else {
            // Saved PIN is not present in the JSON.
            localStorage.removeItem('selectedPincode');

            input.value = '';
            input.disabled = false;
            button.dataset.mode = 'check';
            button.innerHTML = '<i class="bx bx-search-alt-2"></i>';
            resultDiv.textContent = '';
        }
    } catch (error) {
        console.error('Saved pincode verification failed:', error);

        input.value = '';
        input.disabled = false;
        button.dataset.mode = 'check';
        button.innerHTML = '<i class="bx bx-search-alt-2"></i>';

        resultDiv.textContent =
            'Unable to verify your saved pincode. Please try again.';
        resultDiv.style.color = 'red';
    } finally {
        button.disabled = false;
    }
});
</script>
