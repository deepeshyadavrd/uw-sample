$(document).on('input', 'input[name^="quantity["]', function () {
    let value = this.value.replace(/\D/g, '');

    if (value === '') {
        this.value = '';
        return;
    }

    value = parseInt(value, 10);

    if (value < 1) value = 1;
    if (value > 9) value = 9;

    this.value = value;
});


/* PINCODE DATA - CART PAGE  */

let pincodeData = [];
let jsonLoaded = false;
let jsonLoading = null;

function loadPincodeData() {
    if (jsonLoaded) {
        return Promise.resolve();
    }

    if (jsonLoading) {
        return jsonLoading;
    }

    jsonLoading = fetch(
        'catalog/view/theme/default/template/pincodes.json'
    )
        .then(response => {
            if (!response.ok) {
                throw new Error('Failed to load pincode JSON');
            }

            return response.json();
        })
        .then(data => {
            pincodeData = data.pincodes || [];
            jsonLoaded = true;
        })
        .finally(() => {
            jsonLoading = null;
        });

    return jsonLoading;
}

function findPincode(pin) {
    return pincodeData.find(
        p => String(p.pincode).trim() === pin
    ) || null;
}
/* CART PINCODE CHECKER  */
function checkCartPincode() {
    const input = document.getElementById('input-pincode');
    const button = document.querySelector('.search-pincode-btn-modal');
    const resultDiv = document.getElementById('cart-pincode-result');

    if (!input || !button || !resultDiv) return;

    // Change button: allow a new pincode.
    if (button.dataset.mode === 'change') {
        input.disabled = false;
        input.value = '';
        input.focus();

        button.dataset.mode = 'check';
        button.textContent = 'CHECK';

        resultDiv.textContent = 'Enter a new pincode to check.';
        resultDiv.style.color = '#666';
        return;
    }

    const pin = input.value.trim();

    if (!/^\d{6}$/.test(pin)) {
        resultDiv.textContent = 'Please enter a valid 6-digit pincode.';
        resultDiv.style.color = 'red';
        return;
    }

    button.disabled = true;
    resultDiv.textContent = 'Checking delivery area...';
    resultDiv.style.color = '#666';

    (async function () {
        try {
            let found = getCachedPincode(pin);

            // Fetch JSON only if valid details aren't cached.
            if (!found) {
                await loadPincodeData();
                found = findPincode(pin);
            }

            if (found) {
                localStorage.setItem(
                    `pincode-${pin}`,
                    JSON.stringify(found)
                );

                localStorage.setItem('selectedPincode', pin);

                renderCartPincodeSuccess(
                    pin, found, input, button, resultDiv
                );
            } else {
                // Do not overwrite the previous saved PIN on a failed check.
                showCartPincodeUnavailable(resultDiv);
                input.disabled = false;
                button.dataset.mode = 'check';
                button.textContent = 'CHECK';
            }
        } catch (error) {
            console.error('Cart pincode check failed:', error);

            resultDiv.textContent =
                'Unable to check the pincode. Please try again.';
            resultDiv.style.color = 'red';

            input.disabled = false;
            button.dataset.mode = 'check';
            button.textContent = 'CHECK';
        } finally {
            button.disabled = false;
        }
    })();
}


/*  READ CACHED PINCODE DETAILS */

function getCachedPincode(pin) {
    const cached = localStorage.getItem(`pincode-${pin}`);

    if (!cached) return null;

    try {
        const data = JSON.parse(cached);

        if (
            String(data.pincode).trim() === pin &&
            data.district &&
            data.state
        ) {
            return data;
        }
    } catch (error) {
        // Invalid cache; verify against JSON.
    }

    return null;
}


