{{ header }}
{{ menu }}
<div class="wrapper">
<div class="qu-sec py-2 ">
  <div class="container container-custom">
    <div class="row">
<div class="col-md-12 col-sm-12">
  <nav class="breadcumb-navigation">
    <ol class="breadcrumb m-0 p-2">
      {# <li class="breadcrumb-item"><a href="#"><i class="fas fa-home"></i></a></li> #}
      {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>
      {% endfor %}
    </ol>
  </nav>   
</div>
</div>
    </div>
</div>

<section class="text-center not-found-bg">
<div class="container">
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="not-found-page">
                <div class="not-found-content">
                    {% if text_error1 %}
                        <h2>{{ text_error1 }}</h2>
                    {% else %}
                        <h2>Oops! We Can't Find That Page</h2>
                    {% endif %}
                    <p class="mb-3">{{ text_error }}</p>
                     </div>
                <div class="not-found-img">
                    {% if page_type == '404'  %}
                        <img src="catalog/view/javascript/assets/image/not-found.webp" alt="" class="img-fluid">
                    {% else %}
                        <img src="catalog/view/javascript/assets/image/cart-empty.webp" alt="" class="img-fluid">
                    {% endif %}
                </div>
                {% if page_type == '404'  %}
                    <a href="/" class="goback-btn d-inline-block text-center text-white px-4 py-2 mt-4 border rounded-3">Back to Home</a>
                {% else %}
                    <a href="/" class="goback-btn d-inline-block text-center text-white px-4 py-2 mt-4 border rounded-3">Explore Furniture</a>
                {% endif %}
                
            </div>
        </div>
    </div>
</div>
</section>
</div>
{{ footer }}